# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Cron Security (generate a random secret for production)
CRON_SECRET=your-random-secret-here-change-in-production

# App Security (Basic Auth for single-user access)
APP_AUTH_USER=your-username
APP_AUTH_PASS=your-strong-password

# LLM Ranking
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_RANK_MODEL=gpt-4o-mini

# RSS Source URLs
REUTERS_RSS_URL=https://news.google.com/rss/search?q=site%3Areuters.com&hl=en-US&gl=US&ceid=US%3Aen
VERGE_RSS_URL=https://www.theverge.com/rss/index.xml
TECHCRUNCH_RSS_URL=https://techcrunch.com/feed/

# Polling Configuration
FETCH_INTERVAL_MINUTES=15

# Node Environment
NODE_ENV=production
